.DS_Store
**/.DS_Store

# Agent scratch — never committed; this repo's durable memory is research/ and spec/
.agents/

# The `hh`/`hh-kernel` runtime store (HH_STORE_ROOT default `<cwd>/.hh/store`) — local state,
# never committed.
.hh/

# Rust build outputs (E1 workspace + throwaway spike trees). Cargo.lock IS committed.
/target/
**/target/
.idea/

# Python bytecode caches (scripts/site and other python3 checkers)
__pycache__/
*.pyc

.env

# fp-ws1 run-root tar is 1.6 GB — the committed MANIFEST.sha256 already
# checksums every member; the blob itself does not enter history (prior
# harvest tarballs were ~300 KB and committed by precedent).
docs/build/reports/compute/harvest/fp-ws1/run-root.tar.gz
